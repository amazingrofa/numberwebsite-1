@page "/{id:regex(^(0|[1-9][0-9]*)$)}"
@model WebApplication2.Pages.NumberModel
@{
    ViewData["Title"] = $"Number {Model.NumberId}";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Hero Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden text-center">
                <div class="card-body p-5 bg-gradient bg-primary text-white">
                    <span class="badge bg-white text-primary rounded-pill px-3 py-2 fw-bold text-uppercase mb-3">
                        Number Record
                    </span>
                    <h1 class="display-1 fw-black font-monospace mb-0">@Model.NumberId</h1>
                </div>

                <!-- Stats Footer -->
                <div class="card-footer bg-light p-4 border-0">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 bg-white rounded-3 shadow-sm border">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1">Total Views</small>
                                <span id="viewCountDisplay" class="fs-3 fw-bold font-monospace text-dark">
                                    @Model.ViewCount.ToString("N0")
                                </span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-white rounded-3 shadow-sm border">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1">Created</small>
                                <span class="fs-6 fw-semibold text-secondary d-block mt-2" title="@Model.CreatedAt.ToString("f")">
                                    @Model.CreatedAt.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Navigation -->
                    <div class="mt-4 pt-2 border-top d-flex justify-content-between align-items-center">
                        <a href="/top" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                            ← Leaderboard
                        </a>
                        <button onclick="navigator.clipboard.writeText(window.location.href); alert('Link copied!');" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            🔗 Share Number
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const numberId = "@Model.NumberId";

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/viewCountHub")
        .build();

    connection.on("UpdateCount", function(newCount) {
        document.getElementById("viewCountDisplay").innerText = Number(newCount).toLocaleString();
    });

    connection.start().then(function() {
        connection.invoke("JoinNumberGroup", numberId);
    });
</script>