@page "/top"
@model WebApplication2.Pages.TopModel
@{
    ViewData["Title"] = "Leaderboard - Top Numbers";
}

<div class="container py-5" style="max-width: 900px;">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">🏆 Top Most Viewed Numbers</h1>
        <p class="text-muted fs-5">Discover the most visited pages in real-time</p>
    </div>

    @if (!Model.TopNumbers.Any())
    {
        <div class="text-center p-5 bg-light rounded-4 border">
            <p class="text-muted fs-5 mb-0">No numbers have been registered yet.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr class="text-uppercase small text-muted">
                            <th scope="col" class="ps-4 py-3" style="width: 15%;">Rank</th>
                            <th scope="col" class="py-3" style="width: 40%;">Number</th>
                            <th scope="col" class="py-3" style="width: 25%;">Created</th>
                            <th scope="col" class="pe-4 py-3 text-end" style="width: 20%;">Total Views</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int rank = 1;
                        }
                        @foreach (var item in Model.TopNumbers)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (rank == 1)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">🥇 #1</span>
                                    }
                                    else if (rank == 2)
                                    {

                                        <span class="badge bg-secondary rounded-pill px-3 py-2">🥈 #2</span>
                                    }
                                    else if (rank == 3)
                                    {

                                        <span class="badge bg-danger rounded-pill px-3 py-2">🥉 #3</span>
                                    }
                                    else
                                    {

                                        <span class="fw-bold text-muted ps-2">#@rank</span>
                                    }
                                </td>
                                <td>
                                    <a href="/@item.Id" class="fs-4 text-decoration-none font-monospace fw-bold text-primary">
                                        @item.Id
                                    </a>
                                </td>
                                <td>
                                    <small class="text-muted">
                                        @item.CreatedAt.ToString("MMM dd, yyyy")
                                    </small>
                                </td>
                                <td class="pe-4 text-end">
                                    <span class="font-monospace fs-5 fw-bold text-dark">
                                        @item.ViewCount.ToString("N0")
                                    </span>
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>