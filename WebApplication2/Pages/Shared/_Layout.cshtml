<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NumberHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand fw-bold font-monospace fs-4 text-primary" asp-page="/Index">
                    #NumberHub
                </a>
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary rounded-pill px-3" asp-page="/Index">Home</a>
                    <a class="btn btn-sm btn-primary rounded-pill px-3" asp-page="/Top">🏆 Top 100</a>
                </div>
            </div>
        </nav>
    </header>

    <!-- MUST HAVE THIS EXACT LINE BELOW -->
    <main role="main" class="container pb-3">
        @RenderBody()
    </main>

    <footer class="border-top text-muted text-center py-3 bg-white mt-auto">
        <div class="container">
            <small>&copy; @DateTime.Now.Year - NumberHub</small>
        </div>
    </footer>
</body>
</html>